---
import ConversationList from './ConversationList.astro';
import { conversationsIntro } from '../content/conversations';
---

<section id="conversations">
  <div class="section-header">
    <span class="section-number">§ II. — IN THE OPEN</span>
    <h2 class="section-title">
      Conversations <span class="italic">— continued elsewhere</span>
    </h2>
  </div>
  <p class="chronology-intro intro">{conversationsIntro}</p>
  <ConversationList limit={3} />
  <div class="conversations-view-all">
    <a class="conversations-view-all-link" href="/conversations">
      View all conversations &rarr;
    </a>
  </div>
</section>

<style>
  .intro {
    margin-bottom: 2.5rem;
  }

  .conversations-view-all {
    margin-top: 2.5rem;
    text-align: center;
  }

  .conversations-view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s ease,
      gap 0.3s ease;
  }

  .conversations-view-all-link:hover {
    border-color: var(--accent);
    gap: 0.85rem;
  }
</style>
